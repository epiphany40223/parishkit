#!/bin/sh
# Usage: tools/stewardship-ops/pk-admin [--session NAME] [--session-dir DIR]
#        [--export-dir DIR] COMMAND...
#
# The host wrapper of the Admin automation command line (ADM-11): it runs
# `pk-stewardship admin COMMAND...` inside the web container as the
# Administrator who approved the session, sending the session secret on
# standard input. It holds no other behavior; every rule is in the package.
# See docs/guides/stewardship-admin-automation.md.
#
#   pk-admin login start --name NAME --label TEXT --expect-email ADDRESS \
#            --scope read-only|full [--days N]
#       Create the session file NAME (a fresh 256-bit secret) and start
#       pairing; prints the user code and the approval link at once.
#   pk-admin login wait --name NAME [--timeout SECONDS]
#       Wait for the Administrator's approval in the browser.
#   pk-admin [--session NAME] logout
#       End the session, then delete its file.
#   pk-admin [--session NAME] AREA VERB [OPTIONS]
#       Any other command, for example `whoami`, `sessions` or `commands`.
#   pk-admin [--session NAME] logs export [OPTIONS] >FILE
#   pk-admin [--session NAME] export download EXPORT_ID --stream >FILE
#       A command that streams a file writes its bytes to standard output
#       and its document to standard error; it is refused when standard
#       output is a terminal.
#   pk-admin [--session NAME] export fetch EXPORT_ID
#       Run `export status`, then `export download --stream` straight into
#       an owner-only file in the export directory; check its size and
#       SHA-256 against the status, name it EXPORT_ID-FILE_NAME (never
#       overwriting) and print only its path, size and sha256.
#   pk-admin exports clean
#       Delete every fetched export file (and any interrupted fetch).
#
# Session files live in ${PARISHKIT_ROOT:-/opt/parishkit}/run/admin-automation
# (or --session-dir), a directory owned by you with mode 0700; each file is
# NAME.session, owned by you with mode 0600. The session is --session NAME,
# else $PK_ADMIN_SESSION, else the only file in the directory. The secret is
# never an argument of any program and never printed.
#
# Fetched exports go to the export directory: --export-dir, else
# $PK_ADMIN_EXPORT_DIR, else the session directory's `exports`, which the
# wrapper creates owned by you with mode 0700. Delete them once used.
#
# Environment:
#   PARISHKIT_ROOT          the deployment root (default /opt/parishkit)
#   PK_ADMIN_SESSION        the session to use when --session is not given
#   PK_ADMIN_EXPORT_DIR     where `export fetch` writes (default
#                           SESSION_DIR/exports)
#   PK_ADMIN_COMPOSE_FILE   the rendered Compose file
#                           (default ROOT/config/services/compose.json)
#   PK_ADMIN_PROJECT        the Compose project name (default stewardship)
#   PK_ADMIN_WEB_CONFIG     the web configuration path inside the container
#                           (default ROOT/config/services/web.yaml)
#   PK_ADMIN_MACHINE_ID     the machine identity file (default /etc/machine-id)
#
# Exit status: the command's own (0 done, 1 refused, 2 usage or admission,
# 3 unavailable, 4 confirmation not given, 5 no usable session or pairing not
# finished, 6 outcome unknown, 7 watch timed out); 2 for the wrapper's own
# refusals, which happen before anything runs; 1 when `export fetch` names
# an export that is not ready; 3 when a fetched file does not match its
# size and digest (it is deleted; fetch again); 127 when docker, or
# pk-stewardship inside the web container, is not found (126 when it cannot
# run), as the shell and docker report; 130, 143 or 129 when interrupted by
# INT (Ctrl-C), TERM or HUP. An interrupted `--watch` is stopped inside the
# web container too; any other command there runs to its end.
#
# Standard input is forwarded to the command after the preamble only when
# the command line has a `-` input; a command that prompts gets exactly one
# answer line typed at the terminal (at most 256 bytes). Otherwise input
# ends after the preamble, so a run never waits on a terminal nobody is
# typing into, a prompt without a terminal fails at once, and the wrapper
# never waits for more typing once the command has finished. The commands
# in PROMPTING below are the ones that read a terminal's answer.

# Never trace: the session secret passes through this shell's variables.
set +x
set -eu

TAG="pk-admin-session/1"
ROOT=${PARISHKIT_ROOT:-/opt/parishkit}

refuse() {
    printf 'pk-admin: %s\n' "$*" >&2
    exit 2
}

usage() {
    sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2
    exit 2
}

# Owner and permission bits of a path: GNU stat on the host, BSD stat for
# developers' machines.
owner_mode() {
    stat -c '%u %a' "$1" 2>/dev/null || stat -f '%u %Lp' "$1"
}

# Refuse a directory or file that is not owned by this account or that
# grants anything to group or others.
require_private() {
    set -- "$1" "$(owner_mode "$1")"
    owner=${2% *}
    mode=${2#* }
    if [ "$owner" != "$(id -u)" ]; then
        refuse "$1 must be owned by you"
    fi
    case $mode in
        *[1-7]?|*[1-7]) refuse "$1 must not be readable or writable by group or others" ;;
    esac
}

# Character lists are spelled out: a range such as a-z can match capitals
# under some locales' collation.
LOWER=abcdefghijklmnopqrstuvwxyz
UPPER=ABCDEFGHIJKLMNOPQRSTUVWXYZ
DIGITS=0123456789

valid_name() {
    case $1 in
        '' | *[!"$LOWER$DIGITS"-]*) return 1 ;;
    esac
    [ "${#1}" -le 32 ]
}

# Stop a process and its descendants, deepest first; without pgrep, only the
# process itself. Called only from the traps, so shellcheck sees it as unused
# (SC2329) or, before 0.10, unreachable (SC2317).
# shellcheck disable=SC2317,SC2329
stop_tree() {
    for child in $(pgrep -P "$1" 2>/dev/null); do
        stop_tree "$child"
    done
    kill "$1" 2>/dev/null || true
}

session_dir=""
session=""
export_dir=""
while [ "$#" -gt 0 ]; do
    case $1 in
        --session)
            [ "$#" -ge 2 ] || refuse "--session needs a name"
            session=$2
            shift 2
            ;;
        --session-dir)
            [ "$#" -ge 2 ] || refuse "--session-dir needs a directory"
            session_dir=$2
            shift 2
            ;;
        --export-dir)
            [ "$#" -ge 2 ] || refuse "--export-dir needs a directory"
            export_dir=$2
            shift 2
            ;;
        -h | --help) usage ;;
        *) break ;;
    esac
done
[ "$#" -gt 0 ] || usage
session_dir=${session_dir:-$ROOT/run/admin-automation}
compose=${PK_ADMIN_COMPOSE_FILE:-$ROOT/config/services/compose.json}
project=${PK_ADMIN_PROJECT:-stewardship}
web_config=${PK_ADMIN_WEB_CONFIG:-$ROOT/config/services/web.yaml}
machine_id=${PK_ADMIN_MACHINE_ID:-/etc/machine-id}

# The session directory must already exist (provisioning creates it) and be
# private to this account.
if ! { [ -d "$session_dir" ] && [ ! -L "$session_dir" ]; }; then
    refuse "$session_dir is not a directory; see the operator guide"
fi
require_private "$session_dir"
export_dir=${export_dir:-${PK_ADMIN_EXPORT_DIR:-$session_dir/exports}}

# Whether $1 is an export's id: a lowercase UUID (8-4-4-4-12 hex digits).
valid_uuid() {
    case $1 in
        *[!"$DIGITS"abcdef-]*) return 1 ;;
        ????????-????-????-????-????????????) ;;
        *) return 1 ;;
    esac
    # Exactly the four hyphens the pattern places: no digit position holds one.
    [ "$(printf '%s' "$1" | tr -d "$DIGITS"abcdef)" = "----" ]
}

# The export directory, created owner-only on first use; refused when it is
# a link, not yours, or open to group or others.
private_export_dir() {
    # Checked first: fetch prints the path inside a JSON string, so it may
    # hold no quote, backslash or control character (a newline included).
    case $export_dir in
        *[\"\\]* | *[![:print:]]*)
            refuse "the export directory must not contain a quote, backslash, or an unprintable or non-ASCII character"
            ;;
    esac
    if [ ! -e "$export_dir" ] && [ ! -L "$export_dir" ]; then
        (umask 077 && mkdir "$export_dir") 2>/dev/null \
            || refuse "$export_dir could not be created"
    fi
    if ! { [ -d "$export_dir" ] && [ ! -L "$export_dir" ]; }; then
        refuse "$export_dir is not a directory"
    fi
    require_private "$export_dir"
}

if [ "$1" = exports ] && [ "${2:-}" = clean ]; then
    # Delete what `export fetch` left: EXPORT_ID-FILE_NAME files and the
    # .EXPORT_ID.partial of an interrupted fetch; nothing else.
    [ "$#" -eq 2 ] || refuse "usage: pk-admin exports clean"
    private_export_dir
    removed=0
    for path in "$export_dir"/* "$export_dir"/.*.partial; do
        if ! { [ -f "$path" ] && [ ! -L "$path" ]; }; then
            continue
        fi
        name=${path##*/}
        case $name in
            .*.partial)
                id=${name#.}
                id=${id%.partial}
                ;;
            *)
                id=$(printf '%s' "$name" | cut -c1-36)
                case ${name#"$id"} in
                    -?*) ;;
                    *) continue ;;
                esac
                ;;
        esac
        valid_uuid "$id" || continue
        rm -f "$path"
        removed=$((removed + 1))
    done
    printf '{"removed": %s}\n' "$removed"
    exit 0
fi

if [ "$1" = export ] && [ "${2:-}" = fetch ]; then
    # Fetch one export's file into the export directory. The wrapper runs
    # itself for `export status` and `export download --stream`, so each
    # run reads the session and handles its ending as any command does. The
    # file's bytes go from the download's standard output straight into the
    # partial file, created first with umask 077 and exclusive create;
    # they are never copied anywhere else.
    [ "$#" -eq 3 ] || refuse "usage: pk-admin export fetch EXPORT_ID"
    id=$3
    valid_uuid "$id" || refuse "EXPORT_ID must be an export's id (a lowercase UUID)"
    # Stopping the background download on Ctrl-C needs pgrep (procps).
    command -v pgrep >/dev/null 2>&1 || refuse "export fetch needs pgrep (procps)"
    private_export_dir
    if [ -n "$session" ]; then
        set -- --session-dir "$session_dir" --session "$session"
    else
        set -- --session-dir "$session_dir"
    fi
    status=0
    document=$(sh "$0" "$@" export status "$id") || status=$?
    if [ "$status" -ne 0 ]; then
        printf '%s\n' "$document"
        exit "$status"
    fi
    # The status document's own members; each name occurs once in it.
    member() {
        printf '%s\n' "$document" | sed -n "s/.*\"$1\": $2.*/\1/p"
    }
    state=$(member state '"\([a-z_]*\)"')
    if [ "$state" != ready ]; then
        case $state in
            expired) hint="request it again with export regenerate" ;;
            failed) hint="fix the cause, then export retry" ;;
            cancelled) hint="request a new one with export create" ;;
            *) hint="follow it with export status --watch" ;;
        esac
        printf 'pk-admin: export %s is %s, not ready; %s\n' \
            "$id" "${state:-unknown}" "$hint" >&2
        exit 1
    fi
    file_name=$(member file_name '"\([a-z0-9_]*\.[a-z0-9]*\)"')
    expected_size=$(member size '\([0-9][0-9]*\)[,}]')
    expected_sha=$(member sha256 '"\([0-9a-f]\{64\}\)"')
    if [ -z "$file_name" ] || [ -z "$expected_size" ] || [ "${#expected_sha}" -ne 64 ]; then
        refuse "export status did not describe the file"
    fi
    target="$export_dir/$id-$file_name"
    partial="$export_dir/.$id.partial"
    if [ -e "$target" ] || [ -L "$target" ]; then
        refuse "$target already exists; delete it first (pk-admin exports clean)"
    fi
    if [ -e "$partial" ] || [ -L "$partial" ]; then
        refuse "$partial exists: another fetch is running or was interrupted (pk-admin exports clean)"
    fi
    # Ctrl-C, a closed terminal or SSH session, or TERM removes the partial
    # file at once: the download runs in the background, so the trap does
    # not wait for it, and the download (the nested wrapper and, where
    # pgrep exists, every process under it) is stopped first.
    fetching=no
    download=""
    # Called only from the traps below, so shellcheck sees it as unused
    # (SC2329) or, before 0.10, unreachable (SC2317).
    # shellcheck disable=SC2317,SC2329
    stop_fetch() {
        if [ -n "$download" ]; then
            stop_tree "$download"
        fi
        if [ "$fetching" = yes ]; then
            rm -f "$partial"
        fi
        exit "$1"
    }
    trap 'stop_fetch 129' HUP
    trap 'stop_fetch 130' INT
    trap 'stop_fetch 143' TERM
    # Set first, so a signal that lands just after the create removes it.
    fetching=yes
    if ! (
        umask 077
        set -C
        : >"$partial"
    ) 2>/dev/null; then
        fetching=no
        refuse "$partial exists: another fetch is running or was interrupted (pk-admin exports clean)"
    fi
    # Exclusive create refuses only an existing regular file: refuse a
    # planted link, device or FIFO too.
    if ! { [ -f "$partial" ] && [ ! -L "$partial" ]; }; then
        fetching=no
        refuse "$partial is not a regular file"
    fi
    sh "$0" "$@" export download "$id" --stream >>"$partial" &
    download=$!
    wait "$download" || status=$?
    download=""
    if [ "$status" -ne 0 ]; then
        rm -f "$partial"
        exit "$status"
    fi
    size=$(wc -c <"$partial" | tr -d ' ')
    sha=$(openssl dgst -sha256 <"$partial" | sed 's/^.*= *//')
    if [ "$size" != "$expected_size" ] || [ "$sha" != "$expected_sha" ]; then
        rm -f "$partial"
        printf 'pk-admin: the fetched file did not match its size and SHA-256; it was deleted. Fetch it again.\n' >&2
        exit 3
    fi
    # A hard link never replaces an existing name.
    if ! ln "$partial" "$target" 2>/dev/null; then
        rm -f "$partial"
        refuse "$target already exists; delete it first (pk-admin exports clean)"
    fi
    rm -f "$partial"
    fetching=no
    printf '{"path": "%s", "sha256": "%s", "size": %s}\n' "$target" "$sha" "$size"
    exit 0
fi

# The application-specific host digest: HMAC-SHA256 keyed with the machine
# identity over fixed text, so the raw identity never leaves this host.
[ -r "$machine_id" ] || refuse "$machine_id is not readable"
key=$(cat "$machine_id")
[ -n "$key" ] || refuse "$machine_id is empty"
host_digest=$(printf '%s' "parishkit-admin-automation/1" \
    | openssl dgst -sha256 -hmac "$key" | sed 's/^.*= *//')
case $host_digest in
    *[!"$DIGITS"abcdef]* | '') refuse "the host digest could not be computed" ;;
esac
[ "${#host_digest}" -eq 64 ] || refuse "the host digest could not be computed"

# `login start` and `login wait` name their session with --name.
name_option=""
if [ "$1" = login ]; then
    previous=""
    for argument in "$@"; do
        if [ "$previous" = --name ]; then
            name_option=$argument
        fi
        previous=$argument
    done
    [ -n "$name_option" ] || refuse "login ${2:-} needs --name"
    valid_name "$name_option" || refuse "a name is 1 to 32 of a-z, 0-9 and -"
    session=$name_option
fi

if [ -z "$session" ]; then
    session=${PK_ADMIN_SESSION:-}
fi
if [ -z "$session" ]; then
    count=0
    for file in "$session_dir"/*.session; do
        [ -e "$file" ] || continue
        count=$((count + 1))
        found=${file##*/}
    done
    if [ "$count" -eq 0 ]; then
        refuse "no session file in $session_dir; run pk-admin login start first"
    fi
    if [ "$count" -gt 1 ]; then
        printf 'pk-admin: several sessions; choose one with --session NAME:\n' >&2
        for file in "$session_dir"/*.session; do
            name=${file##*/}
            printf '  %s\n' "${name%.session}" >&2
        done
        exit 2
    fi
    session=${found%.session}
fi
valid_name "$session" || refuse "a name is 1 to 32 of a-z, 0-9 and -"
file="$session_dir/$session.session"

# Set while this run's new session file is not yet a started pairing, so an
# interruption or a failed start removes it.
created=no
# Set just before the run starts; its last process; for a watch, the token
# that finds the watch's process in the web container (see `interrupted`);
# the stop command's process; and the input writer (see below).
started=no
running=""
writer=""
token=""
stopper=""

# Run inside the web container with the token as $1: SIGINT to every process
# whose environment holds PK_ADMIN_RUN=TOKEN, which is this run's watch
# alone (the container has no pgrep). Exit 3 when none was found (docker
# itself fails with 1 or 125 to 127). Expanded only in the container.
# shellcheck disable=SC2016
STOP_WATCH='found=3
for process in /proc/[0-9]*; do
    if tr "\000" "\n" <"$process/environ" 2>/dev/null | grep -qxF "PK_ADMIN_RUN=$1"; then
        kill -INT "${process#/proc/}" 2>/dev/null && found=0
    fi
done
exit "$found"'

# Whether file $1 has content within $2 tenths of a second. Called only from
# the traps, so shellcheck sees it as unused or unreachable.
# shellcheck disable=SC2317,SC2329
await() {
    ticks=0
    while [ ! -s "$1" ]; do
        [ "$ticks" -lt "$2" ] || return 1
        sleep 0.1
        ticks=$((ticks + 1))
    done
}

# Ctrl-C, TERM, or a closed terminal or SSH session (HUP): exit 130, 143 or
# 129 at once. `docker exec` forwards no signal, so for a watch the stop
# command is started first, before anything that could fail (a write to a
# terminal that has hung up fails, and `set -e` would end the handler): it
# sends the watch SIGINT inside the web container, which ends it its own
# way (exit 7, watch_interrupted, its session closed and its events
# logged). Its outcome is reported, waiting at most 10 seconds for it; then,
# after Ctrl-C (INT) only, at most 5 seconds for the watch's last document,
# so it is shown: after HUP there is no terminal to show it on, and TERM to
# the whole process group has already ended the processes relaying it.
# Other commands run on in the container, as an interrupted write would
# leave an unknown outcome. Then every process this run started (the docker
# client included) is stopped, and the input writer by name, since without
# pgrep the process tree cannot be walked: a writer left waiting at the
# terminal would swallow the operator's next line. Every message here
# tolerates a failed write. Further signals meanwhile are caught and
# ignored; a caught signal, unlike an ignored one, is reset to its default
# in the children started here. A signal in the instant after the run
# starts but before the watch exists in the container finds nothing, and
# says so. Called only from the traps below.
# shellcheck disable=SC2317,SC2329
interrupted() {
    trap : HUP INT TERM
    # A closed standard error pipe (`2>&1 | jq`) must fail a write, not end
    # the wrapper before its cleanup.
    trap '' PIPE
    if [ "$started" = yes ] && [ -n "$token" ]; then
        {
            # Its own session too, where the watch's is: a second Ctrl-C
            # would otherwise end this docker client (Go restores SIGINT).
            # shellcheck disable=SC2086
            $launch docker compose -f "$compose" -p "$project" exec -T web \
                sh -c "$STOP_WATCH" sh "$token" </dev/null >"$work/stop" 2>&1 \
                && stop=0 || stop=$?
            printf '%s\n' "$stop" >"$work/stop-status"
        } &
        stopper=$!
    fi
    if [ "$created" = yes ]; then
        rm -f "$file" || :
    fi
    if [ -n "$stopper" ]; then
        printf 'pk-admin: interrupted; stopping the watch in the web container\n' >&2 || :
        stop=none
        if await "$work/stop-status" 100; then
            stop=$(cat "$work/stop-status")
        fi
        case $stop in
            0) ;;
            3)
                printf 'pk-admin: no running watch was found in the web container (it had ended, or had not yet started)\n' >&2 || :
                ;;
            none)
                printf 'pk-admin: the stop command did not finish within 10 seconds; the watch ends at its timeout, or revoke the session in Automation access\n' >&2 || :
                ;;
            *)
                printf 'pk-admin: the watch could not be stopped (exit %s); it ends at its timeout, or revoke the session in Automation access:\n' "$stop" >&2 || :
                sed 's/^/pk-admin:   /' "$work/stop" >&2 || :
                ;;
        esac
        if [ "$stop" = 0 ] && [ "$1" -eq 130 ]; then
            # The status file appears once the docker client has ended (a
            # finished background process can linger unreaped, so it is
            # not polled); tee then ends once it has shown what was left.
            if await "$work/status" 50; then
                wait "$running" || :
            else
                printf "pk-admin: the watch's last document did not arrive within 5 seconds\n" >&2 || :
            fi
        fi
    fi
    for child in $(pgrep -P "$$" 2>/dev/null); do
        stop_tree "$child"
    done
    if [ -n "$running" ]; then
        kill "$running" 2>/dev/null || :
    fi
    if [ -n "$writer" ]; then
        kill "$writer" 2>/dev/null || :
    fi
    exit "$1"
}
trap 'interrupted 129' HUP
trap 'interrupted 130' INT
trap 'interrupted 143' TERM

if [ "$1" = login ] && [ "${2:-}" = start ]; then
    # Exclusive create with umask 077: never overwrite an existing session.
    if [ -e "$file" ] || [ -L "$file" ]; then
        refuse "$file already exists"
    fi
    secret=$(head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '=\n')
    [ "${#secret}" -eq 43 ] || refuse "no random secret could be made"
    (
        umask 077
        set -C
        printf '%s %s\n' "$TAG" "$secret" >"$file"
    ) || refuse "$file could not be created"
    created=yes
fi

# Read and check the session file: a private regular file of one line,
# at most 128 bytes, in the tagged format.
if ! { [ -f "$file" ] && [ ! -L "$file" ]; }; then
    refuse "no session $session in $session_dir"
fi
require_private "$file"
[ "$(wc -c <"$file")" -le 128 ] || refuse "$file is not a session file"
IFS=' ' read -r tag secret rest <"$file" || refuse "$file is not a session file"
if ! { [ "$tag" = "$TAG" ] && [ -z "${rest:-}" ]; }; then
    refuse "$file is not a session file"
fi
case $secret in
    *[!"$LOWER$UPPER$DIGITS"_-]* | '') refuse "$file is not a session file" ;;
esac
[ "${#secret}" -eq 43 ] || refuse "$file is not a session file"

# Commands that stream a file to standard output, as AREA_VERB words
# separated by spaces. Their bytes are never written to a terminal: redirect
# standard output to a file.
STREAMING="logs_export export_download"
# The work file the command's document is read from (see `reports`).
documents=output
for command in $STREAMING; do
    if [ "$command" = "$1${2:+_$2}" ]; then
        [ ! -t 1 ] || refuse "$1 $2 writes a file; redirect standard output to a file"
        documents=errors
    fi
done
if [ "$documents" = errors ]; then
    # For a streaming command, `docker` below is this function. The
    # command's standard output is this run's own (descriptor 6), so the
    # file's bytes go straight to the operator's file, are never copied,
    # and a failure to write them reaches the command, which reports it.
    # Its standard error, which carries its document last, is shown as it
    # comes and kept in the work directory for `reports`, so an interrupted
    # run has already shown what arrived. The pipeline's status is tee's,
    # so the command's own is passed through a file. The run below calls it
    # after an optional `setsid` word, which shellcheck cannot follow.
    exec 6>&1
    # shellcheck disable=SC2317,SC2329
    docker() {
        {
            command docker "$@" 2>&1 >&6 6>&-
            printf '%s\n' "$?" >"$work/stream-status"
        } | tee "$work/errors" >&2
        return "$(cat "$work/stream-status" 2>/dev/null || echo 1)"
    }
fi

# Commands that prompt for a confirmation, as AREA_VERB words separated by
# spaces (for example "send_confirm"). They read their answer from a
# terminal after the preamble.
# Every catalog command with `prompts` is listed, except one that accepts
# only `--yes` (YES_ONLY in tests/stewardship/test_pk_admin.py, which checks
# this list).
PROMPTING="test_sample test_families export_regenerate digest_weekly-request export_financial export_directory export_postal delivery_resend delivery_refusal-clear export_family-timeline"

# Forward this standard input after the preamble only for a `-` input; a
# prompting command run from a terminal gets one answer line (see the
# header).
forward=no
for argument in "$@"; do
    if [ "$argument" = - ]; then
        forward=yes
    fi
done
prompt=no
if [ -t 0 ]; then
    for command in $PROMPTING; do
        if [ "$command" = "$1${2:+_$2}" ]; then
            prompt=yes
        fi
    done
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/pk-admin.XXXXXX")
trap 'rm -rf "$work"' EXIT

# A watch (`--watch SECONDS` or `--watch=SECONDS`, the number optionally
# signed with `+`, before any `--`) gets a
# random token in its environment, so an interruption can find and stop it
# inside the web container (see `interrupted`). It is hex, so the unquoted
# option below splits into exactly `-e PK_ADMIN_RUN=TOKEN`.
previous=""
for argument in "$@"; do
    [ "$argument" != -- ] || break
    case $previous/$argument in
        --watch/[0-9]* | --watch/+[0-9]* | */--watch=[0-9]* | */--watch=+[0-9]*)
            token=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
            [ "${#token}" -eq 32 ] || refuse "no random token could be made"
            ;;
    esac
    previous=$argument
done
# The watch's docker client, and the stop command (see `interrupted`), run in
# their own sessions where `setsid -w` works (util-linux, on a Linux host;
# busybox's setsid has no -w). `docker compose` exits at once on SIGINT, so
# if Ctrl-C reached the watch's client, its last document would be lost, and
# a second Ctrl-C would end the stop command. The forwarded stop ends the
# watch, and with it the client. Without `setsid -w` both run as usual
# (`command docker`). A streaming command's `docker` is the function above,
# which setsid cannot run; none of them watches. Isolation also needs pgrep:
# an isolated client no longer gets the terminal's SIGINT, so if the stop
# fails only the process-tree walk can end it.
isolate=""
launch="command"
if [ -n "$token" ] && [ "$documents" = output ] \
    && command -v pgrep >/dev/null 2>&1 \
    && setsid -w true </dev/null >/dev/null 2>&1; then
    isolate=yes
    launch="setsid -w"
fi

# The command's input is written by a separate writer through a FIFO, so
# the wrapper can stop it once the command exits: a writer still waiting at
# the terminal for an answer the command no longer needs must not keep the
# wrapper waiting until someone presses Enter. Standard input is passed to
# the writer explicitly (descriptor 4), since an asynchronous list would
# otherwise read /dev/null; when standard input is closed it is /dev/null
# (a failed `exec` redirection would end the shell, so it is tried in a
# subshell first).
mkfifo "$work/input"
if (exec 3<&0) 2>/dev/null; then
    exec 4<&0
else
    exec 4</dev/null
fi
{
    printf '%s %s %s\n' "$TAG" "$secret" "$host_digest"
    if [ "$forward" = yes ]; then
        cat <&4
    elif [ "$prompt" = yes ]; then
        # One answer line, at most 256 bytes, sent after the preamble while
        # the command waits at its prompt; nothing else is read.
        if IFS= read -r answer <&4 && [ "${#answer}" -le 256 ]; then
            printf '%s\n' "$answer"
        fi
    fi
} >"$work/input" &
writer=$!
exec 4<&-

# Stream the command's output as it comes, keeping a copy to decide whether
# the session file must go; the command's own exit status is kept aside.
# The run is a background job so a signal's trap runs at once rather than
# when the run ends; its input is the writer's FIFO.
started=yes
{
    ${isolate:+setsid -w} docker compose -f "$compose" -p "$project" \
        exec -T ${token:+-e PK_ADMIN_RUN=$token} web \
        pk-stewardship admin "$@" --config "$web_config" --session-stdin \
        <"$work/input" && status=0 || status=$?
    printf '%s\n' "$status" >"$work/status"
} | tee "$work/output" &
running=$!
wait "$running" || true
running=""
status=$(cat "$work/status")
kill "$writer" 2>/dev/null || true
wait "$writer" 2>/dev/null || true
secret=""

remove_file() {
    rm -f "$file"
    created=no
    printf 'pk-admin: removed session file %s (%s)\n' "$file" "$1" >&2
}

# Whether the command's document (its one line, with sorted keys) reports
# this top-level error code: `"error": {"code": "...", ...}` directly in the
# document, never a match anywhere in its text.
reports() {
    tail -n 1 "$work/$documents" | grep -q "^{\"command\": [^{]*, \"error\": {\"code\": \"$1\", "
}

if [ "$status" -eq 5 ] && reports session_ended; then
    remove_file "the session has ended"
elif [ "$status" -eq 5 ] && [ "$1" = login ] && reports pairing_expired; then
    remove_file "the pairing expired"
elif [ "$1" = logout ] && [ "$status" -eq 0 ]; then
    remove_file "logged out"
elif [ "$1" = login ] && [ "${2:-}" = start ] && [ "$status" -ne 0 ]; then
    remove_file "pairing did not start"
fi
# A started pairing keeps its file.
created=no
exit "$status"
